<Window x:Class="SpeechToTextButtonWithOpenAIWhisper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpeechToTextButtonWithOpenAIWhisper"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="textBox" SelectionChanged="TextBox_SelectionChanged" />
        <telerik:RadSpeechToTextButton x:Name="speechToTextButton"
                                       IsContinuousRecognition="False"
                                       ErrorOccurred="SpeechToTextButton_ErrorOccurred"
                                       StateChanged="SpeechToTextButton_StateChanged"
                                       SpeechRecognized="SpeechToTextButton_SpeechRecognized"
                                       Grid.Row="1"
                                       HorizontalAlignment="Right" />
    </Grid>

</Window>
