<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SpeechToTextButtonWithOpenAIWhisper.MainPage">

    <Grid RowDefinitions="*, Auto">
        <Editor x:Name="editor" TextChanged="Editor_TextChanged" />
        <telerik:RadSpeechToTextButton x:Name="speechToTextButton"
                                       IsContinuousRecognition="False"
                                       ErrorOccurred="SpeechToTextButton_ErrorOccurred"
                                       StateChanged="SpeechToTextButton_StateChanged"
                                       SpeechRecognized="SpeechToTextButton_SpeechRecognized"
                                       Grid.Row="1"
                                       HorizontalOptions="End" />
    </Grid>

</ContentPage>
